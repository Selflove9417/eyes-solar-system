{
  "manifest_version": 3,
  "name": "NASA Eyes 太阳系中文汉化",
  "version": "0.2.0",
  "description": "在 eyes.nasa.gov 官方站点内把界面文字与 3D 天体标签替换为简体中文。非官方项目，不改动任何模拟计算，不托管 NASA 资源。",
  "content_scripts": [
    {
      "matches": [
        "https://eyes.nasa.gov/apps/solar-system/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/names.zh.json",
        "data/ui.zh.json",
        "data/bodies.zh.json",
        "data/missions.zh.json",
        "data/events.zh.json",
        "data/more.zh.json"
      ],
      "matches": [
        "https://eyes.nasa.gov/*"
      ]
    }
  ]
}
