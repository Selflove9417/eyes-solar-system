# Cloudflare Pages 响应头配置规范

# 1. 静态资源（CSS / JS / 图片 / 字体）：具备 ?v= 版本指纹，设置长达 1 年的永久不可变强缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 2. 天体与科普数据（JSON）：设置 1 天边缘与浏览器缓存，配合后台平滑重新验证
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 3. 搜索引擎协议文件
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# 4. HTML 入口与文档：强制协商缓存，确保用户始终即时获取最新指纹页面
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

# 5. 全局基础安全响应头
# - CSP 必须保留 script-src/style-src 的 'unsafe-inline'：12 个页面都含内联 module 脚本，
#   HTML 里还有内联 style 属性；frame-src 必须放行 eyes.nasa.gov，否则 3D 视窗全黑。
# - 不要加 COEP/COOP：会破坏 NASA 页面内部的第三方资源。
# - HSTS 只对本域生效，不含 includeSubDomains（pages.dev 是共享域）。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://eyes.nasa.gov; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
